# Non-secret choices live in config/profiles/<PANDA_PROFILE>.yaml (default: local). Anything here overrides the profile.
# PANDA_PROFILE=local

# --- LLM ---------------------------------------------------------------
# mock   : offline rule-based fallback, no credentials (default, great for dev/demo fallback)
# gemini : Google Gemini. Either an AI Studio key ...
LLM_PROVIDER=mock
GOOGLE_API_KEY=
# ... or Vertex AI, keyless via Application Default Credentials (gcloud auth application-default login; Cloud Run service account in prod)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=ai-builder-hackathon
# GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
GEMINI_PRO_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_LOCATION=   (empty = GOOGLE_CLOUD_LOCATION; set a region if the embedding model is not served on global)
# LLM_MAX_CALLS_PER_TURN=8

# --- Engine ------------------------------------------------------------
# duckdb | bigquery
ENGINE=duckdb
# BQ_DATASET=panda
# BQ_LOCATION=asia-southeast1
# BQ_MAX_BYTES_BILLED=10737418240   (10 GiB per query)

# --- Optional Postgres (pgvector + LangGraph checkpointer) --------------
# AlloyDB or Cloud SQL: only the host changes. Keep the password out of the URL: export PGPASSWORD (Secret Manager on Cloud Run).
# DATABASE_URL=postgresql://panda:panda@localhost:5433/panda
# DATABASE_URL=postgresql://panda_app@10.0.0.5:5432/panda?sslmode=require
# DB_POOL_MAX=5
# DB_CONNECT_TIMEOUT_S=5
# DB_POOL_TIMEOUT_S=10
# VECTOR_INDEX=none   (none | hnsw | scann; scann = AlloyDB only)

# --- Auth and abuse controls ---------------------------------------------
# dev (fixed local user) | firebase (ID token required)
AUTH_MODE=dev
# FIREBASE_PROJECT_ID=ai-builder-hackathon
# DAILY_USER_QUERY_LIMIT=30
# DAILY_GLOBAL_QUERY_LIMIT=300
# MAX_REQUEST_BYTES=16384
# IP_RATE_PER_MINUTE=120
# IP_RATE_BURST=20

# --- Observability ------------------------------------------------------
LOG_LEVEL=INFO
# TRACE_PAYLOADS=true   # DEBUG logs include SQL and model output (never enable in shared environments)
# Optional LangSmith tracing of every LangGraph run:
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=panda
