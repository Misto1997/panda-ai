# Firebase Auth (Google sign-in). Leave all four unset to run without login (dev).
# NEXT_PUBLIC_* values are inlined at BUILD time (npm run build / docker build), not read at runtime.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Runtime (server side): where the BFF finds the gateway
GATEWAY_URL=http://localhost:8000
